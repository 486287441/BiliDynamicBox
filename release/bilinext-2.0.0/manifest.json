{
  "manifest_version": 3,
  "name": "BiliNext - B站重构：全新首页、内容管理与自动追番",
  "version": "2.0.0",
  "description": "重做 B 站首页与动态：自动追番抓取更新、聚合推荐与关注，一键想看、不想看。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://api.deepseek.com/*",
    "https://api.bgm.tv/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "dist/background/index.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dist/assets/fonts/*"
      ],
      "matches": [
        "https://t.bilibili.com/*",
        "https://www.bilibili.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://t.bilibili.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "dist/content/content.js"
      ],
      "css": [
        "dist/content/style.css"
      ],
      "run_at": "document_start",
      "match_about_blank": true,
      "all_frames": true
    },
    {
      "matches": [
        "https://t.bilibili.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "dist/inject/index.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
